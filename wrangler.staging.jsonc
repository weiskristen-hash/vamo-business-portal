{
  // Staging web build, served as a Cloudflare Worker with static assets at
  // https://staging-business.vamo-app.com (Worker name "business-staging" on the
  // islavibe-dr account subdomain). Separate from the production Worker
  // "vamo-business-portal" (https://business.vamo-app.com).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "business-staging",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/vamo-business-portal/browser",
    "not_found_handling": "single-page-application"
  }
}
